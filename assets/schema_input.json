{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snsinfu/nf-cov/main/assets/schema_input.json",
    "title": "nf-cov pipeline - params.input schema",
    "description": "Schema for the samplesheet provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["id"],
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q(\\.gz)?$",
                "errorMessage": "FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq', '.fastq', '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq', '.fastq', '.fq.gz' or '.fastq.gz'",
                "anyOf": [
                    {
                        "type": "string",
                        "format": "file-path",
                        "exists": true,
                        "pattern": "^\\S+\\.f(ast)?q(\\.gz)?$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "replicate": {
                "type": "integer",
                "meta": ["replicate"],
                "errorMessage": "replicate must be an integer (biological replicate)"
            },
            "tech_replicate": {
                "anyOf": [
                    {
                        "type": "integer"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ],
                "meta": ["tech_replicate"],
                "errorMessage": "tech_replicate must be an integer (optional, defaults to 1)"
            }
        },
        "required": ["sample", "fastq_1", "replicate"]
    }
}
