/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-cov Nextflow process config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process-specific ext.args / ext.prefix / publishDir selectors.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.library}.run${meta.run}" }
        publishDir = [
            [ path: { "${params.outdir}/fastqc" },      mode: params.publish_dir_mode, pattern: "*.html" ],
            [ path: { "${params.outdir}/fastqc/zips" }, mode: params.publish_dir_mode, pattern: "*.zip"  ]
        ]
    }

    withName: 'TRIMGALORE' {
        ext.prefix = { "${meta.library}.run${meta.run}" }
        publishDir = [
            [ path: { "${params.outdir}/trimgalore/logs" }, mode: params.publish_dir_mode, pattern: "*report.txt" ]
        ]
    }

    withName: 'BWA_MEM' {
        ext.args   = { meta.read_group ? "-R '${meta.read_group}'" : '' }
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }

    withName: 'BWAMEM2_MEM' {
        ext.args   = { meta.read_group ? "-R '${meta.read_group}'" : '' }
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }

    withName: 'BWAMEM3_MEM' {
        ext.args   = { meta.read_group ? "-R '${meta.read_group}'" : '' }
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }

    withName: '.*:SAMTOOLS_MERGE_MLB' {
        ext.prefix = { "${meta.id}.mLb" }
        publishDir = [
            [ path: { "${params.outdir}/${params.aligner}/merged_library/bam" }, mode: params.publish_dir_mode, pattern: "*.mLb.bam" ]
        ]
    }

    withName: '.*:SAMTOOLS_MERGE_MRP' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [ path: { "${params.outdir}/${params.aligner}/merged_replicate/bam" }, mode: params.publish_dir_mode, pattern: "*.mRp.bam" ]
        ]
    }

    withName: '.*:BAM_LIBRARY:SAMTOOLS_MERGE' {
        ext.prefix = { meta.id }
        publishDir = [
            [ path: { "${params.outdir}/${params.aligner}/library/bam" }, mode: params.publish_dir_mode,
              pattern: "*.bam", enabled: params.save_library ]
        ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        ext.args   = '--REMOVE_DUPLICATES false --ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT --TMP_DIR .'
        ext.prefix = { "${meta.library}.mkd" }
        publishDir = [
            [ path: { "${params.outdir}/picard" }, mode: params.publish_dir_mode, pattern: "*.metrics.txt" ]
        ]
    }

    withName: 'SAMTOOLS_VIEW' {
        ext.args = {
            //
            // Clean filter plus a paired-end-only fragment-length filter on TLEN. samtools
            // filter expressions have no abs(), so both mate signs are matched explicitly.
            //
            def args = ["-F 3844", "-q ${params.min_mapq}"]
            if (!meta.single_end) {
                def min = params.min_fragment_size != null ? params.min_fragment_size as Integer : null
                def max = params.max_fragment_size != null ? params.max_fragment_size as Integer : null
                def expr = null
                if (min != null && max != null) {
                    expr = "((tlen >= ${min}) && (tlen <= ${max})) || ((tlen <= -${min}) && (tlen >= -${max}))"
                }
                else if (min != null) {
                    expr = "(tlen >= ${min}) || (tlen <= -${min})"
                }
                else if (max != null) {
                    expr = "(tlen <= ${max}) && (tlen >= -${max})"
                }
                if (expr) {
                    args << "-e '${expr}'"
                }
            }
            args.join(' ')
        }
        ext.prefix = { "${meta.library}.clean" }
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [ [ path: { "${params.outdir}/samtools/stats" }, mode: params.publish_dir_mode, pattern: "*.stats" ] ]
    }

    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [ [ path: { "${params.outdir}/samtools/flagstat" }, mode: params.publish_dir_mode, pattern: "*.flagstat" ] ]
    }

    withName: 'SAMTOOLS_IDXSTATS' {
        publishDir = [ [ path: { "${params.outdir}/samtools/idxstats" }, mode: params.publish_dir_mode, pattern: "*.idxstats" ] ]
    }

    withName: 'PRESEQ_LCEXTRAP' {
        errorStrategy = 'ignore'
        ext.prefix    = { "${meta.id}" }
        publishDir = [ [ path: { "${params.outdir}/preseq" }, mode: params.publish_dir_mode, pattern: "*.lc_extrap.txt" ] ]
    }

    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        // bamCoverage at small binSize is CPU- and memory-heavy on large genomes.
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
        ext.args = {
            def extend = meta.single_end
                ? (params.fragment_size > 0 ? "--extendReads ${params.fragment_size}" : '')
                : '--extendReads'
            def exclude = params.normalization_exclude_chroms
                ? "--ignoreForNormalization ${params.normalization_exclude_chroms.split(',').join(' ')}"
                : ''
            [
                "--normalizeUsing ${params.normalization}",
                "--effectiveGenomeSize ${meta.egs}",
                "--binSize ${params.bin_size}",
                extend,
                exclude
            ].findAll { arg -> arg }.join(' ').trim()
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [ path: { "${params.outdir}/${params.aligner}/library/bigwig" },         mode: params.publish_dir_mode, pattern: "*.bigWig", enabled: params.save_library ],
            [ path: { "${params.outdir}/${params.aligner}/merged_library/bigwig" },  mode: params.publish_dir_mode, pattern: "*.mLb.bigWig" ],
            [ path: { "${params.outdir}/${params.aligner}/merged_replicate/bigwig" }, mode: params.publish_dir_mode, pattern: "*.mRp.bigWig" ]
        ]
    }
}
