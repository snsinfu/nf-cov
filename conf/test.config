/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Standalone test config for direct runs:
        nextflow run . -profile test
    The `test` profile in nextflow.config includes this plus the local catalog.
    Run without a catalog with, e.g.:
        nextflow run . -c conf/test.config --fasta tests/data/genome.fa \
            --effective_genome_size 500000 --igenomes_ignore
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    igenomes_ignore              = true
    normalization_exclude_chroms = ''
    skip_preseq                  = true
}
