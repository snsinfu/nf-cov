/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-cov Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments.
----------------------------------------------------------------------------------------
*/

params {
    // Input/output options
    input              = null
    outdir             = 'results'
    publish_dir_mode   = 'copy'

    // Reference options
    genome             = null
    igenomes_base      = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore    = false
    fasta              = null
    bwa_index          = null       // precomputed BWA index directory (used with --aligner bwa)
    bwamem2_index      = null       // precomputed bwa-mem2 index directory (used with --aligner bwa-mem2)
    bwamem3_index      = null       // precomputed bwa-mem3 index directory (used with --aligner bwa-mem3)
    aligner            = 'bwa'

    // Effective genome size (RPGC)
    effective_genome_size = null    // explicit int; else catalog macs_gsize[read_length]; else khmer
    read_length           = null    // plain int; inferred from FASTQ when unset

    // Coverage options
    bin_size                     = 1
    normalization                = 'RPGC'  // None|CPM|RPKM|BPM|RPGC
    min_mapq                     = 1
    fragment_size                = 0       // 0 = auto (PE: --extendReads; SE: no extension)
    normalization_exclude_chroms = null    // default: catalog mito_name

    // Output options
    save_library       = false      // publish per-tech-library bigWigs

    // QC options
    skip_fastqc        = false
    skip_trimming      = false
    skip_preseq        = false

    // Boilerplate options
    monochrome_logs    = false
}

process.shell = [
    'bash',
    '-C',       // No clobber
    '-e',       // Exit on non-zero
    '-u',       // Error on unset variables
    '-o',       // Set pipefail
    'pipefail',
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

includeConfig 'conf/base.config'

// Load iGenomes unless ignored
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

profiles {
    debug {
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}

manifest {
    name            = 'nf-cov'
    author          = 'snsinfu'
    homePage        = 'https://github.com/snsinfu/nf-cov'
    description     = 'FASTQ to genome-wide coverage bigWig'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = '0.1.0'
}

plugins {
    id 'nf-schema@2.5.1'
}

validation {
    defaultIgnoreParams = ["genomes"]
}

includeConfig 'conf/modules.config'
