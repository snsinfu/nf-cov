nextflow_pipeline {

    name "Test nf-cov with PE + SE and replicates"
    script "../main.nf"
    tag "pipeline"
    profile "test"

    test("default") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/samplesheet_abs.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },

                // .mLb per biological replicate
                { assert file("$outputDir/bwa/merged_library/bigwig/sampleA_REP1.mLb.bigWig").exists() },
                { assert file("$outputDir/bwa/merged_library/bigwig/sampleA_REP2.mLb.bigWig").exists() },
                { assert file("$outputDir/bwa/merged_library/bigwig/sampleB_REP1.mLb.bigWig").exists() },

                // .mRp only for the multi-bio-replicate sample
                { assert file("$outputDir/bwa/merged_replicate/bigwig/sampleA.mRp.bigWig").exists() },
                { assert !file("$outputDir/bwa/merged_replicate/bigwig/sampleB.mRp.bigWig").exists() },

                // Library bigWigs are opt-in
                { assert !file("$outputDir/bwa/library/bigwig/sampleA_REP1_T1.bigWig").exists() },

                // QC outputs
                { assert file("$outputDir/picard/sampleA_REP1_T1.mkd.metrics.txt").exists() },
                { assert file("$outputDir/samtools/stats/sampleA_REP1_T1.stats").exists() },
                { assert file("$outputDir/samtools/flagstat/sampleA_REP1_T1.flagstat").exists() },
                { assert file("$outputDir/pipeline_info/nf-cov_software_mqc_versions.yml").exists() }
            )
        }
    }

    test("--save_library") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/samplesheet_abs.csv"
                save_library = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("$outputDir/bwa/library/bigwig/sampleA_REP1_T1.bigWig").exists() },
                { assert file("$outputDir/bwa/library/bigwig/sampleA_REP1_T2.bigWig").exists() },
                { assert file("$outputDir/bwa/library/bigwig/sampleA_REP2_T1.bigWig").exists() },
                { assert file("$outputDir/bwa/library/bigwig/sampleB_REP1_T1.bigWig").exists() }
            )
        }
    }
}
